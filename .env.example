# =============================================================================
# .env.example — Agente Local
# =============================================================================
# Copie para .env e ajuste conforme necessario:
#   cp .env.example .env
# =============================================================================

# --- Modelo Padrao (Ollama) ---
# Modelo que sera usado para responder perguntas e chamadas de ferramentas.
# Precisa estar baixado no Ollama:
#   ollama pull qwen2.5:7b      ( leve, 8GB RAM )
#   ollama pull qwen2.5:32b     ( RECOMENDADO, 24GB+ RAM )
#   ollama pull llama3.1:70b     ( maior qualidade, 48GB+ RAM )
AGENTE_MODEL=qwen2.5:7b

# --- Modelo de Visao (multimodal) ---
# Opcoes: llava, bakllava, llava:13b, llama3.2-vision:11b
AGENTE_VISION_MODEL=llava

# --- Modelo de Embeddings (busca semantica) ---
AGENTE_EMBEDDING_MODEL=nomic-embed-text

# --- Modelo Whisper (transcricao de audio) ---
AGENTE_WHISPER_MODEL=whisper-large-v3

# --- Qualidade de raciocinio ---
# Contexto: 32K padrao, modelos grandes suportam 128K
AGENTE_NUM_CTX=32768
AGENTE_TEMPERATURE=0.5
AGENTE_MAX_TOKENS=4096

# --- Robustez ---
AGENTE_TIMEOUT=300
AGENTE_KEEP_ALIVE=5m
AGENTE_MAX_TOOL_ROUNDS=15
AGENTE_MAX_HISTORY=120
AGENTE_MAX_RETRIES=3
AGENTE_AUTO_CONTEXT=5000

# --- Servidor (agente_api_server.py) ---
AGENTE_HOST=0.0.0.0
AGENTE_PORT=8000

# --- API Fallback (quando modelo local nao da conta) ---
# Se ativado, usa OpenAI/Anthropic automaticamente quando Ollama falha
# AGENTE_FALLBACK_ENABLED=true
# AGENTE_FALLBACK_MODEL=gpt-4o
# Threshold de confianca 0.0-1.0 (0.7 = fallback quando confianca < 70%)
# AGENTE_FALLBACK_THRESHOLD=0.7
# Limite de gasto em USD com APIs (previne surpresas)
# AGENTE_COST_LIMIT=10.0

# --- Prompt Caching (reduz tokens repetidos em ate 90%) ---
# AGENTE_CACHE_ENABLED=true
# AGENTE_CACHE_TTL=600

# --- API Keys para fallback ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- Seguranca da API ---
AGENTE_API_KEY=
AGENTE_RATE_LIMIT=60
AGENTE_RATE_LIMIT_WINDOW=60

# --- Brave Search API (gratuita: 2000 queries/mes) ---
# Cadastro: https://brave.com/search/api/
BRAVE_API_KEY=

# --- ChromaDB (cache semantico de respostas) ---
AGENTE_CHROMA_DIR=agente_data/chroma_cache

# --- Backup Automatico ---
AGENTE_MAX_BACKUPS=10

# --- Feedback ---
AGENTE_MAX_FEEDBACK=1000

# --- Open WebUI (opcional) ---
WEBUI_SECRET_KEY=change-me-in-production

# --- Firecrawl (web scraping avancado) ---
# Modo cloud: obtem API key em https://firecrawl.dev
# FIRECRAWL_API_KEY=fc-...
# Modo self-hosted: docker run -p 3023:3023 mendableai/firecrawl
# FIRECRAWL_URL=http://localhost:3023

# --- Mem0 (camada de memoria avancada) ---
# Modo cloud: obtem API key em https://app.mem0.ai
# MEM0_API_KEY=m0-...
# Modo self-hosted: docker compose up (com Qdrant)
# MEM0_URL=http://localhost:6333
# IDs para isolamento de memorias
MEM0_USER_ID=default_user
MEM0_AGENT_ID=agente_local
MEM0_COLLECTION=agente_memories

# --- GitHub API ---
# Gere um Personal Access Token em: https://github.com/settings/tokens
# Permissoes: repo, read:org, read:user
GITHUB_TOKEN=

# --- Playwright (browser automation) ---
# Instale: pip install playwright && playwright install
# Sem config necessaria, funciona out-of-the-box

# --- Slack Integration ---
# Crie um Incoming Webhook: https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# SLACK_BOT_TOKEN=xoxb-...

# --- Microsoft Teams Integration ---
# Crie um Incoming Webhook: https://learn.microsoft.com/en-us/microsoftteams/platform/webhooks-and-connectors/how-to/add-incoming-webhook
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# --- Discord Integration ---
# Crie um Webhook: https://discord.com/developers/docs/resources/webhook
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
